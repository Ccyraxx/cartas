<?php

class Cartas
{
    private $cartas = [
        1  => "Louco",
        2  => "Mago",
        3  => "Sacerdotisa",
        4  => "Imperatriz",
        5  => "Imperador",
        6  => "Papa",
        7  => "Enamorados",
        8  => "Carro",
        9  => "Justiça",
        10 => "Eremita",
        11 => "Roda da Fortuna",
        12 => "Força",
        13 => "Enforcado",
        14 => "Morte",
        15 => "Temperança",
        16 => "Diabo",
        17 => "Torre",
        18 => "Estrela",
        19 => "Lua",
        20 => "Sol",
        21 => "Julgamento",
        22 => "Mundo"
    ];

    public function aleatorio()
    {
        return array_rand($this->cartas);
    }

    public function dicas($cartaSorteada) 
    {
        $dicas = [
            1  => "Representa novos começos, liberdade, espontaneidade e um salto de fé.",
            2  => "Representa habilidade, foco, manifestação e ter os recursos necessários nas mãos.",
            3  => "Representa intuição, mistério, sabedoria interior e o inconsciente.",
            4  => "Representa fertilidade, abundância, natureza e o cuidado materno.",
            5  => "Representa autoridade, estrutura, controle e poder de liderança.",
            6  => "Representa tradição, espiritualidade, ensinamentos e regras morais.",
            7  => "Representa escolhas, união, relacionamentos e alinhamento de valores.",
            8  => "Representa determinação, controle, vitória e avanço rápido.",
            9  => "Representa equilíbrio, verdade, causa e efeito e decisões fair-play.",
            10 => "Representa introspecção, busca por respostas, prudência e solidão reflexiva.",
            11 => "Representa ciclos, destino, altos e baixos e mudanças inevitáveis.",
            12 => "Representa coragem, paciência, autocontrole e força interior (não física).",
            13 => "Representa pausa, mudança de perspectiva, entrega e ver as coisas por outro ângulo.",
            14 => "Representa encerramentos, transformação profunda e novos ciclos (não significa morte física!).",
            15 => "Representa moderação, equilíbrio, harmonia e paciência.",
            16 => "Representa tentação, apegos, ilusões e vícios.",
            17 => "Representa destruição de falsas estruturas, revelação súbita e mudanças imprevisíveis.",
            18 => "Representa esperança, inspiração, fé e renovação espiritual.",
            19 => "Representa ilusão, medo, incerteza e coisas escondidas na sombra.",
            20 => "Representa clareza, sucesso, vitalidade, alegria e iluminação.",
            21 => "Representa despertar, avaliação, chamado da vida e perdão.",
            22 => "Representa realização, conclusão de um ciclo, integração e sucesso total."
        ];

        echo "\n💡 DICA DA CARTA:\n";

        if (isset($dicas[$cartaSorteada])) {
            echo "-> " . $dicas[$cartaSorteada] . "\n\n";
        } else {
            echo "-> Nenhuma dica disponível para esta carta.\n\n";
        }
    }

    public function getCartas()
    {
        return $this->cartas;
    }

    public function setCartas($cartas): self
    {
        $this->cartas = $cartas;

        return $this;
    }
}

$carta = new Cartas();

do {
    echo "\n-----------MENU PRINCIPAL-----------\n";
    echo "1- Adivinhar \n";
    echo "0- Sair\n";

    $opcaoPrincipal = readline("Informe a opção: ");
    echo "\n";

    switch ($opcaoPrincipal) {
        case 1:
            $cartaSorteada = $carta->aleatorio(); 
            system("clear");
            do {
                echo "\n-----------MENU DE CARTAS-----------\n";
                echo "1- Louco\n";
                echo "2- Mago\n";
                echo "3- Sacerdotisa\n";
                echo "4- Imperatriz\n";
                echo "5- Imperador\n";
                echo "6- Papa\n";
                echo "7- Enamorados\n";
                echo "8- Carro\n";
                echo "9- Justiça\n";
                echo "10- Eremita\n";
                echo "11- Roda da Fortuna\n";
                echo "12- Força\n";
                echo "13- Enforcado\n";
                echo "14- Morte\n";
                echo "15- Temperança\n";
                echo "16- Diabo\n";
                echo "17- Torre\n";
                echo "18- Estrela\n";
                echo "19- Lua\n";
                echo "20- Sol\n";
                echo "21- Julgamento\n";
                echo "22- Mundo\n";
                echo "23- Dicas\n";
                echo "0- Voltar ao Menu Principal\n";

                $opcaoCartas = readline("Informe a opção: ");
                echo "\n";

                if ($opcaoCartas >= 1 && $opcaoCartas <= 22) {
                    system("clear");
                    
                    if ($opcaoCartas == $cartaSorteada) {
                        print "Você acertou!!!\n";
                        $cartaSorteada = $carta->aleatorio();
                    } else {
                        print "Você errou! A carta era: " . $opcaoCartas . " (tente novamente!)\n";
                    }
                } elseif ($opcaoCartas == 0) {
                    system("clear");
                    echo "Voltando ao menu principal...\n";
                } elseif ($opcaoCartas == 23) {
                    system("clear");
                    $carta->dicas($cartaSorteada);
                } else {
                    echo "Opção inválida!\n";
                }

            } while ($opcaoCartas != 0);
            break;

        case 0:
            system("clear");
            echo "Programa encerrado!\n";
            break;

        default:
            echo "Opção Inválida!\n";
            break;
    }

} while ($opcaoPrincipal != 0);
